{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["src/gen/", "deps/", "dist/", "storybook-static/"],
  "env": {
    "browser": true,
    "es2024": true
  }
}
