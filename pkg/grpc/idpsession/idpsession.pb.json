      "messages": [
        {
          "name": "Binding",
          "longName": "Binding",
          "fullName": "idpsession.Binding",
          "description": "Binding binds a Pomerium client session to a given IDPSession and its set of tokens.\nIt is used to map (in a concurrently safe way) which Pomerium client sessions\nbelong to a user's IDP session.\nPomerium client sessions are always represented by their own databroker record.\nIn particular, a Binding's ID must match its corresponding bound record's ID. The\ntype of client it is bound to is represented by its type_url field.\nIt acts an authoritative source about the state of the session. If the binding exists,\nit is active, if not, the client session is no longer valid.\nThe deletion of a binding is expected to (eventually) delete the client session record.\nA Binding must also point to their parent IDPSession. Deleting an IDPSession is expected\nto (eventually) delete its associated bindings.\nBinding IDs should be unique to a client session and never re-used on subsequent bindings\nof the same client session type.",
          "hasExtensions": false,
          "hasFields": true,
          "hasOneofs": false,
          "extensions": [],
